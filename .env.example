COMPOSE_PROJECT_NAME=yijiatong-dev

MYSQL_IMAGE=mysql:8.4.9
MYSQL_DATABASE=yijiatong
MYSQL_USER=yijiatong
MYSQL_PASSWORD=change_me_for_local_development
MYSQL_ROOT_PASSWORD=change_me_for_local_development
MYSQL_PORT=3306

REDIS_IMAGE=redis:8.6.3
REDIS_PASSWORD=change_me_for_local_development
REDIS_PORT=6379

# P3 backend and administration UI. Copy to a local .env and replace every change_me value.
BACKEND_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yijiatong
DB_USERNAME=yijiatong
DB_PASSWORD=change_me_for_local_development
REDIS_HOST=127.0.0.1
REDIS_DATABASE=0
REDIS_USERNAME=default
REDIS_KEY_PREFIX=yijiatong:
SA_TOKEN_JWT_SECRET=change_me_with_at_least_32_random_characters
ACTUATOR_USERNAME=replace_with_local_health_username
ACTUATOR_PASSWORD=change_me_with_a_strong_health_password
CAPTCHA_ENABLED=true
API_ENCRYPT_ENABLED=false
API_DOCS_ENABLED=false
ADMIN_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_UI_URL=http://localhost:5173
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=replace_with_local_admin_username
ADMIN_PASSWORD=change_me_with_a_strong_local_password
VITE_APP_BASE_API=/dev-api
VITE_APP_CLIENT_ID=yijiatong-p3-admin
